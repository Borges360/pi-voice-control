{
  "schema": "harness/project/v1",
  "id": "pi-voice-control",
  "name": "pi-voice-control",
  "sourceRoot": "../workspace",
  "sourceVersion": "0.3.0",
  "kind": "node",
  "manager": "npm",
  "runtime": "node",
  "worktreeOf": null,
  "commands": {
    "install": "npm ci",
    "lint": "npm run lint",
    "test": "npm test",
    "build": "npm run build",
    "dev": null,
    "compose": null,
    "composeUp": null,
    "composeDown": null
  },
  "gitflow": {
    "main": "main",
    "develop": "develop",
    "featurePrefix": "feature/",
    "featurePrefixes": [
      "feature/",
      "codex/"
    ],
    "releasePrefix": "release/",
    "hotfixPrefix": "hotfix/",
    "allowDirectPushToMain": false
  },
  "memory": {
    "workspace": "homelab",
    "server": "https://memory.lab/mcp",
    "tokenEnv": "AI_MEMORY_TOKEN",
    "project": "pi-voice-control"
  },
  "guardrails": [],
  "pipelines": [],
  "memoryScopeVerified": false
}
