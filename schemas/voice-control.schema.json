{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Borges360/pi-voice-control/schemas/voice-control.schema.json",
  "title": "Pi Voice Control configuration overrides",
  "description": "Partial local-only overrides, validated after merging defaults/global/project/env/CLI.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shortcut": {
      "type": "string",
      "pattern": "^f(?:[1-9]|1[0-2])$",
      "default": "f8"
    },
    "language": {
      "type": "string",
      "pattern": "^(?:auto|[a-z]{2,3}(?:-[A-Za-z]{2,4})?)$",
      "default": "pt"
    },
    "debounceMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 1000,
      "default": 250
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "ffmpeg"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sampleRate": {
          "const": 16000
        },
        "channels": {
          "const": 1
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 120
        },
        "minMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000,
          "default": 350
        },
        "silenceRms": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.1,
          "default": 0.002
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": {
          "enum": [
            "auto",
            "belowEditor",
            "status"
          ]
        },
        "waveform": {
          "type": "boolean"
        },
        "showDuration": {
          "type": "boolean"
        },
        "bars": {
          "type": "integer",
          "minimum": 14,
          "maximum": 20,
          "default": 14
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 8
        },
        "noiseFloorDb": {
          "type": "number",
          "minimum": -90,
          "maximum": -10,
          "default": -60
        }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "enum": [
            "tiny",
            "base",
            "small"
          ],
          "default": "tiny"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "default": 120000
        },
        "autoSubmit": {
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retainAudio": {
          "const": false
        },
        "retainTranscripts": {
          "const": false
        },
        "telemetry": {
          "const": false
        }
      }
    }
  }
}
